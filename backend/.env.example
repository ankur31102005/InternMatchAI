# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://internmatch:internmatch_secret@localhost:5432/internmatch

# ── JWT ───────────────────────────────────────────────────────
SECRET_KEY=your-super-secret-key-change-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── App ───────────────────────────────────────────────────────
APP_NAME=InternMatch AI
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development

# ── CORS ──────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Storage ───────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# ── AI Service ────────────────────────────────────────────────
AI_SERVICE_URL=http://localhost:8001

# ── Google OAuth ──────────────────────────────────────────────
# Paste your Google OAuth "Client ID" (same value as the frontend's
# NEXT_PUBLIC_GOOGLE_CLIENT_ID). Leave blank to disable Google sign-in.
GOOGLE_CLIENT_ID=458502262514-ab1jc7t0m7l4355u3rk04ns784csdael.apps.googleusercontent.com

# ── AI Career Assistant (Phase 3) — free Google Gemini ────────
# FREE Gemini API key from https://aistudio.google.com/apikey (no card needed).
# Leave blank to disable the chat assistant.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
# gemini-flash-latest (free, works for new keys) | gemini-2.5-flash (old keys only)
CHAT_MODEL=gemini-flash-latest

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
